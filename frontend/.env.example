# LifeLink AI - Frontend Environment Configuration

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Firebase Web Client Configuration (Optional)
# If left blank, the frontend runs in Safe Dev / Demo Mode with full local mock persistence
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=lifelink-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lifelink-ai
VITE_FIREBASE_STORAGE_BUCKET=lifelink-ai.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Emergency SMS Gateway Fallback Mode (live vs mock preview)
VITE_ENABLE_LIVE_SMS=false
VITE_ENABLE_JUDGE_DEMO_MODE=true
