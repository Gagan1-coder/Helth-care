# LifeLink AI - Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & Secret Keys
SECRET_KEY=lifelink-super-secret-key-change-in-production-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Firebase Configuration
# Optional: Path to Firebase Admin service account JSON credentials
# If omitted or file not found, system gracefully activates Local Mock / Dev mode
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=lifelink-emergency-ai

# Maps & Location Services
# Optional: Google Maps Platform API key (for Places API, Geocoding)
# If omitted, system utilizes OpenStreetMap / Overpass API for real zero-cost healthcare queries
GOOGLE_MAPS_API_KEY=

# Agentic AI Configuration
# Optional: LLM API key (OpenAI / Anthropic / Gemini compatible)
# If omitted, system activates deterministic Rule-Based Emergency Coordinator fallback
LLM_API_KEY=
LLM_PROVIDER=rules_based_fallback  # or openai, gemini, anthropic
LLM_MODEL=gemini-1.5-flash

# Emergency SMS Gateway (Twilio / Mock)
# If credentials not provided, system routes to Local Verified Mock Provider and logs dispatch
SMS_PROVIDER=mock  # or twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Rate Limiting & Safety
MAX_SOS_PER_USER_PER_HOUR=5
DUPLICATE_SOS_WINDOW_SECONDS=60
